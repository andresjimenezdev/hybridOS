# Public values safe to expose in the browser. Find them in Supabase project settings.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key

# Server-only values for the Google Sheets bridge.
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=1XGrFyCW-fS5-rRiBMsjtWR8f4peHz_gu05Z4Qx3URH8

# Server-only values used by the legacy migration and Apple Health bridge.
# Never expose these values with a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=
HYBRIDOS_USER_ID=

# Server-only bearer token used by the personal iOS Shortcut.
# Generate with: openssl rand -hex 32
APPLE_HEALTH_SYNC_SECRET=
