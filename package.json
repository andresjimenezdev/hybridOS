{
  "name": "hybrid-os",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "qa": "npm run typecheck && npm run lint && npm test && npm run build",
    "import:legacy": "node --env-file=.env.local --import tsx scripts/import-legacy-google-sheet.ts",
    "icons": "node scripts/generate-pwa-icons.mjs"
  },
  "keywords": [
    "health",
    "training",
    "pwa"
  ],
  "license": "UNLICENSED",
  "description": "Personal health, training and sports performance system.",
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.116.0",
    "next": "^16.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^26.6.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.13",
    "typescript": "^6.0.3",
    "vitest": "^5.0.1"
  }
}
